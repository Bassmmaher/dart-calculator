def calculate(num1, num2, operation):
    result = 0
    
    if operation in ["add", "+"]:
        result = num1 + num2
    elif operation in ["subtract", "-"]:
        result = num1 - num2
    elif operation in ["multiply", "*"]:
        result = num1 * num2
    elif operation in ["divide", "/"]:
        if num2 == 0:
            return "Error: Cannot divide by zero"
        result = num1 / num2
    elif operation in ["modulus", "%"]:
        if num2 == 0:
            return "Error: Cannot modulus by zero"
        result = num1 % num2
    else:
        return "Error: Invalid operation"
    
    return result

# Quick test:
print(calculate(10, 5, "add"))     # 15
print(calculate(10, 5, "+"))       # 15
print(calculate(10, 0, "/"))       # Error message
